FROM python:3.12-slim

LABEL maintainer="iamprbkr"
LABEL description="AI-Native Cyber Resilience Platform"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=1.8

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libffi-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/base.txt .
RUN pip install --no-cache-dir -r base.txt

COPY . .
RUN pip install --no-cache-dir -e .

RUN useradd -m -u 1000 resilience && \
    chown -R resilience:resilience /app

USER resilience

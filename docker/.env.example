# AI-Native Cyber Resilience Platform
# Copy to .env and fill in your values

# Logging
RESILIENCE_LOG_LEVEL=INFO
RESILIENCE_LOG_FORMAT=json

# Message Bus
RESILIENCE_MESSAGE_BUS_HOST=localhost
RESILIENCE_MESSAGE_BUS_PORT=6379

# AI/LLM Provider
RESILIENCE_AI_PROVIDER=openai
RESILIENCE_AI_MODEL=gpt-4o-mini
RESILIENCE_AI_TEMPERATURE=0.3
RESILIENCE_AI_MAX_TOKENS=1024
RESILIENCE_AI_TIMEOUT_SECONDS=30

# Security
RESILIENCE_SECRET_CIPHER_KEY=
RESILIENCE_AUDIT_LOG_ENABLED=true

# Platform
RESILIENCE_MAX_ALERTS_PER_BATCH=1000
RESILIENCE_REQUEST_TIMEOUT_SECONDS=10
